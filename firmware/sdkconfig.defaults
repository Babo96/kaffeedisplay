CONFIG_IDF_TARGET="esp32s3"

# Flash: 16 MB, quad, 80 MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Octal PSRAM (ESP32-S3R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# UI/LVGL objects are small; keep the internal heap for task stacks and DMA by
# sending allocations above 1 KiB to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# Tasks and system
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=n

# Wi-Fi: AP+STA, no Bluetooth
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_11KV_SUPPORT=y
# Low-traffic kiosk AP: eight static RX buffers are ample and each one is
# 1600 B of scarce internal RAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4

# HTTP / networking
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=1024
# The HTTP server stack is set in ApiServerImpl::start(); esp_http_server has no
# Kconfig option for it (CONFIG_HTTPD_TASK_STACK_SIZE is not a real symbol).
CONFIG_MDNS_MAX_SERVICES=4
CONFIG_MDNS_TASK_STACK_SIZE=4096
# mDNS does not write flash, so keep its task and allocations in PSRAM. This
# preserves internal RAM for the LVGL/HTTP/serial task stacks and LVGL objects.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# OTA rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# LittleFS
CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64

# LVGL defaults (components may override)
CONFIG_LV_COLOR_DEPTH_16=y
# I4 indexed-image palettes are ARGB8888 even on an RGB565 display.
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888=y
CONFIG_LV_USE_QRCODE=y
# Use malloc/free instead of LVGL's fixed internal-RAM pool. The pool otherwise
# reserves 64 KiB and starves the network/HTTP/console stacks; CLIB allocations
# can spill to PSRAM.
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y

# Logs
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Optional STA+AP NAPT (disabled by default in settings, enabled in the build)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
