CONFIG_IDF_TARGET="esp32s3"

# Flash: 16 MB, quad, 80 MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Octal PSRAM (ESP32-S3R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# UI/LVGL objects are small; keep the internal heap for task stacks and DMA by
# sending allocations above 1 KiB to PSRAM. Measured: raising this to 4 KiB so
# LVGL objects stay internal exhausts internal RAM (largest free block 16 B on a
# 12-tile page) and does not make page switches faster.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# Build profile: the software renderer draws every pixel on the CPU, and the
# ESP-IDF default (-Og) leaves a large factor on the table for scroll/refresh
# latency. Size is not the constraint (216 KiB of the app partition free).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# ESP-IDF defaults the S3 to 160 MHz; the panel is 480x480 and every frame is
# drawn on the CPU, so run at the maximum the chip supports.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Tasks and system
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=n

# Wi-Fi: AP+STA, no Bluetooth
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_11KV_SUPPORT=y
# Low-traffic kiosk AP: eight static RX buffers are ample and each one is
# 1600 B of scarce internal RAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4

# HTTP / networking
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=1024
# The HTTP server stack is set in ApiServerImpl::start(); esp_http_server has no
# Kconfig option for it (CONFIG_HTTPD_TASK_STACK_SIZE is not a real symbol).
CONFIG_MDNS_MAX_SERVICES=4
CONFIG_MDNS_TASK_STACK_SIZE=4096
# mDNS does not write flash, so keep its task and allocations in PSRAM. This
# preserves internal RAM for the LVGL/HTTP/serial task stacks and LVGL objects.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# OTA rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# LittleFS
CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64

# microSD backup (FAT32 only; no exFAT). Long file names are off by default;
# without this the monthly `kaffeekasse_YYYY-MM_transactions.csv` cannot be
# created. Heap LFN only allocates while a name is resolved.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# Only the one SD volume; LittleFS uses its own VFS driver.
CONFIG_FATFS_VOLUME_COUNT=1

# LVGL defaults (components may override)
CONFIG_LV_COLOR_DEPTH_16=y
# I4 avatars and I8 standby images use ARGB8888 palettes even on an RGB565 display.
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888=y
CONFIG_LV_USE_QRCODE=y
# The device UI draws every object, button, label, line and image itself and
# never initialises an LVGL theme. Only these widgets are used (plus tileview
# and the QR code); the rest are disabled to stay inside the 3 MiB OTA app
# budget after the microSD/FatFs stack was added. Examples and demos are not
# part of the image and would otherwise reference the disabled widgets.
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_BAR=n
CONFIG_LV_USE_BUTTON=y
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGE=y
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=y
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=y
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_THEME_MONO=n
CONFIG_LV_USE_GRID=n
CONFIG_LV_USE_OBSERVER=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
# Use malloc/free instead of LVGL's fixed internal-RAM pool. The pool otherwise
# reserves 64 KiB and starves the network/HTTP/console stacks; CLIB allocations
# can spill to PSRAM.
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y

# Logs
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Optional STA+AP NAPT (disabled by default in settings, enabled in the build)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
